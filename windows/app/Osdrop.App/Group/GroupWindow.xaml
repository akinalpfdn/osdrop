<Window x:Class="Osdrop.App.Group.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Osdrop.Localization;assembly=Osdrop.Localization"
        xmlns:group="clr-namespace:Osdrop.App.Group"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=group:GroupViewModel}"
        Title="{x:Static res:Strings.GroupWindowTitle}"
        Width="{StaticResource Osdrop.Width.GroupWindow}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="{StaticResource Osdrop.Thickness.WindowPadding}">
    <StackPanel Visibility="{Binding WasRemoved, Converter={StaticResource Osdrop.Converter.Visible}}"
                Margin="{StaticResource Osdrop.Thickness.SectionGap}">
      <TextBlock Text="{x:Static res:Strings.GroupRemoved}" Style="{StaticResource Osdrop.Text.Warning}" />
      <Button Content="{x:Static res:Strings.GroupDismiss}" Command="{Binding DismissRemovalCommand}"
              HorizontalAlignment="Left" Style="{StaticResource Osdrop.Button}" />
    </StackPanel>

    <StackPanel Visibility="{Binding HasClipboardNotice, Converter={StaticResource Osdrop.Converter.Visible}}"
                Margin="{StaticResource Osdrop.Thickness.SectionGap}">
      <TextBlock Text="{Binding ClipboardNotice}" Style="{StaticResource Osdrop.Text.Warning}" />
      <Button Content="{x:Static res:Strings.GroupDismiss}" Command="{Binding DismissClipboardNoticeCommand}"
              HorizontalAlignment="Left" Style="{StaticResource Osdrop.Button}" />
    </StackPanel>

    <TextBlock Text="{x:Static res:Strings.GroupMembers}" Style="{StaticResource Osdrop.Text.Title}" />
    <TextBlock Text="{x:Static res:Strings.GroupEmpty}" Style="{StaticResource Osdrop.Text.Caption}"
               Visibility="{Binding IsInGroup, Converter={StaticResource Osdrop.Converter.Hidden}}" />
    <ItemsControl ItemsSource="{Binding Members}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type group:MemberItem}">
          <DockPanel Margin="{StaticResource Osdrop.Thickness.ItemGap}">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.GroupBlock}"
                    Command="{Binding DataContext.BlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Visibility="{Binding CanRemove, Converter={StaticResource Osdrop.Converter.Visible}}"
                    Style="{StaticResource Osdrop.Button}" />
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.GroupRemove}"
                    Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Visibility="{Binding CanRemove, Converter={StaticResource Osdrop.Converter.Visible}}"
                    Margin="{StaticResource Osdrop.Thickness.ButtonGap}" Style="{StaticResource Osdrop.Button}" />
            <StackPanel>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Osdrop.Text.Body}" />
              <TextBlock Text="{Binding Status}" Style="{StaticResource Osdrop.Text.Caption}" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Content="{x:Static res:Strings.GroupLeave}" Command="{Binding LeaveCommand}" HorizontalAlignment="Left"
            Visibility="{Binding IsInGroup, Converter={StaticResource Osdrop.Converter.Visible}}"
            Margin="{StaticResource Osdrop.Thickness.ItemGap}" Style="{StaticResource Osdrop.Button}" />

    <StackPanel Visibility="{Binding HasBlocked, Converter={StaticResource Osdrop.Converter.Visible}}">
      <TextBlock Text="{x:Static res:Strings.GroupBlocked}" Margin="{StaticResource Osdrop.Thickness.SectionGap}"
                 Style="{StaticResource Osdrop.Text.Title}" />
      <TextBlock Text="{x:Static res:Strings.GroupBlockedHint}" Style="{StaticResource Osdrop.Text.Caption}" />
      <ItemsControl ItemsSource="{Binding Blocked}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type group:BlockedItem}">
            <DockPanel Margin="{StaticResource Osdrop.Thickness.ItemGap}">
              <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.GroupUnblock}"
                      Command="{Binding DataContext.UnblockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" Style="{StaticResource Osdrop.Button}" />
              <TextBlock Text="{Binding Name}" Style="{StaticResource Osdrop.Text.Body}" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TextBlock Text="{x:Static res:Strings.GroupNearby}" Margin="{StaticResource Osdrop.Thickness.SectionGap}"
               Style="{StaticResource Osdrop.Text.Title}" />
    <TextBlock Text="{x:Static res:Strings.GroupNearbyNone}" Style="{StaticResource Osdrop.Text.Caption}"
               Visibility="{Binding Nearby.Count, Converter={StaticResource Osdrop.Converter.Zero}}" />
    <ItemsControl ItemsSource="{Binding Nearby}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type group:NearbyItem}">
          <DockPanel Margin="{StaticResource Osdrop.Thickness.ItemGap}">
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.GroupPair}"
                    Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" IsEnabled="{Binding CanPair}" Style="{StaticResource Osdrop.Button}" />
            <StackPanel>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Osdrop.Text.Body}" />
              <TextBlock Text="{Binding Note}" Style="{StaticResource Osdrop.Text.Caption}"
                         Visibility="{Binding HasNote, Converter={StaticResource Osdrop.Converter.Visible}}" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</Window>
