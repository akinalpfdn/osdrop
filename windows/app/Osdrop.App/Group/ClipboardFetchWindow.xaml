<Window x:Class="Osdrop.App.Group.ClipboardFetchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Osdrop.Localization;assembly=Osdrop.Localization"
        xmlns:group="clr-namespace:Osdrop.App.Group"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=group:ClipboardFetchViewModel}"
        Title="{x:Static res:Strings.AppName}"
        Width="{StaticResource Osdrop.Width.FetchWindow}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
  <StackPanel Margin="{StaticResource Osdrop.Thickness.WindowPadding}">
    <TextBlock Text="{Binding Message}" Style="{StaticResource Osdrop.Text.Body}" />
    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                 Height="{StaticResource Osdrop.Height.ProgressBar}"
                 Margin="{StaticResource Osdrop.Thickness.ItemGap}"
                 AutomationProperties.Name="{x:Static res:Strings.ClipboardFetchProgress}" />
    <TextBlock Text="{Binding Progress}" Margin="{StaticResource Osdrop.Thickness.ItemGap}"
               Style="{StaticResource Osdrop.Text.Body}" />
    <TextBlock Text="{x:Static res:Strings.ClipboardFetchingHint}" Margin="{StaticResource Osdrop.Thickness.ItemGap}"
               Style="{StaticResource Osdrop.Text.Body}" />
    <Button Content="{x:Static res:Strings.ClipboardFetchCancel}" Command="{Binding CancelCommand}"
            HorizontalAlignment="Right" Margin="{StaticResource Osdrop.Thickness.SectionGap}"
            Style="{StaticResource Osdrop.Button}" />
  </StackPanel>
</Window>
