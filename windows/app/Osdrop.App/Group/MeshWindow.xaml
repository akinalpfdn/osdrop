<ui:FluentWindow x:Class="Osdrop.App.Group.MeshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:Osdrop.Localization;assembly=Osdrop.Localization"
        xmlns:group="clr-namespace:Osdrop.App.Group"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=group:GroupViewModel}"
        Title="{x:Static res:Strings.MeshWindowTitle}"
        Width="{StaticResource Osdrop.Width.MeshWindow}"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
  <DockPanel>
  <ui:TitleBar DockPanel.Dock="Top" Title="{x:Static res:Strings.MeshWindowTitle}" ShowMaximize="False" ShowMinimize="False" />
  <StackPanel Margin="{StaticResource Osdrop.Thickness.WindowPadding}">
    <TextBlock Style="{StaticResource Osdrop.Text.Mono}">
      <Run Text="{x:Static res:Strings.MeshDevice}" /> <Run Text="{Binding DeviceId, Mode=OneWay}" />
    </TextBlock>
    <TextBlock Style="{StaticResource Osdrop.Text.Mono}">
      <Run Text="{x:Static res:Strings.MeshGroup}" /> <Run Text="{Binding GroupId, Mode=OneWay}" />
    </TextBlock>
    <TextBlock Style="{StaticResource Osdrop.Text.Mono}">
      <Run Text="{x:Static res:Strings.MeshPort}" /> <Run Text="{Binding ListenPort, Mode=OneWay}" />
    </TextBlock>
    <ItemsControl ItemsSource="{Binding Members}" Margin="{StaticResource Osdrop.Thickness.SectionGap}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type group:MemberItem}">
          <StackPanel Margin="{StaticResource Osdrop.Thickness.ItemGap}">
            <TextBlock Text="{Binding Name}" Style="{StaticResource Osdrop.Text.Title}" />
            <TextBlock Text="{Binding DeviceId}" Style="{StaticResource Osdrop.Text.Mono}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Osdrop.Text.Caption}" />
            <TextBlock Text="{Binding RoundTrip}" Style="{StaticResource Osdrop.Text.Caption}" />
            <TextBlock Text="{Binding ClockOffset}" Style="{StaticResource Osdrop.Text.Caption}" />
            <TextBlock Text="{Binding Rejected}" Style="{StaticResource Osdrop.Text.Caption}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
  </DockPanel>
</ui:FluentWindow>
