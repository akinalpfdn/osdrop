<!-- Shared styles built only from Tokens.xaml and WPF-UI theme resources. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Osdrop.App.Controls">
  <!-- Merged here so StaticResource finds the tokens while this dictionary loads. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <controls:BooleanToVisibility x:Key="Osdrop.Converter.Visible" />
  <controls:BooleanToVisibility x:Key="Osdrop.Converter.Hidden" Invert="True" />
  <controls:ZeroToVisibility x:Key="Osdrop.Converter.Zero" />
  <controls:NullToVisibility x:Key="Osdrop.Converter.NotNull" />
  <controls:AllFalseToVisibility x:Key="Osdrop.Converter.AllFalse" />

  <Style x:Key="Osdrop.Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Osdrop.FontSize.Body}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="Osdrop.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Body}">
    <Setter Property="FontSize" Value="{StaticResource Osdrop.FontSize.Title}" />
    <Setter Property="FontWeight" Value="{StaticResource Osdrop.FontWeight.Emphasis}" />
  </Style>
  <!-- A heading inside the panel or a settings page. -->
  <Style x:Key="Osdrop.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Body}">
    <Setter Property="FontWeight" Value="{StaticResource Osdrop.FontWeight.Emphasis}" />
    <Setter Property="Margin" Value="{StaticResource Osdrop.Thickness.SectionGap}" />
  </Style>
  <Style x:Key="Osdrop.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Body}">
    <Setter Property="FontSize" Value="{StaticResource Osdrop.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="Osdrop.Text.Warning" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Caption}">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
  </Style>
  <Style x:Key="Osdrop.Text.Error" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Caption}">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>
  <Style x:Key="Osdrop.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Caption}">
    <Setter Property="FontFamily" Value="{StaticResource Osdrop.Font.Monospace}" />
  </Style>
  <Style x:Key="Osdrop.Text.Code" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Body}">
    <Setter Property="FontFamily" Value="{StaticResource Osdrop.Font.Monospace}" />
    <Setter Property="FontSize" Value="{StaticResource Osdrop.FontSize.PairingCode}" />
    <Setter Property="FontWeight" Value="{StaticResource Osdrop.FontWeight.Emphasis}" />
  </Style>

  <!-- A thin rule between the panel's sections. -->
  <Style x:Key="Osdrop.Divider" TargetType="Border">
    <Setter Property="Margin" Value="{StaticResource Osdrop.Thickness.SectionGap}" />
    <Setter Property="BorderThickness" Value="{StaticResource Osdrop.Thickness.Divider}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- A member's state, as on the Mac: green connected, amber not responding, grey otherwise. -->
  <Style x:Key="Osdrop.StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="{StaticResource Osdrop.Size.StatusDot}" />
    <Setter Property="Height" Value="{StaticResource Osdrop.Size.StatusDot}" />
    <Setter Property="Margin" Value="{StaticResource Osdrop.Thickness.StatusDot}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="Good">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Warning">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
