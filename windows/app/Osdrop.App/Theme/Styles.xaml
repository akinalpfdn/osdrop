<!-- Text and control styles built from Tokens.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Osdrop.App.Controls">
  <controls:BooleanToVisibility x:Key="Osdrop.Converter.Visible" />
  <controls:BooleanToVisibility x:Key="Osdrop.Converter.Hidden" Invert="True" />
  <controls:ZeroToVisibility x:Key="Osdrop.Converter.Zero" />

  <Style x:Key="Osdrop.Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Osdrop.FontSize.Body}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Osdrop.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Body}">
    <Setter Property="FontSize" Value="{StaticResource Osdrop.FontSize.Title}" />
    <Setter Property="FontWeight" Value="{StaticResource Osdrop.FontWeight.Emphasis}" />
  </Style>
  <Style x:Key="Osdrop.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Body}">
    <Setter Property="FontSize" Value="{StaticResource Osdrop.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Osdrop.Brush.Secondary}" />
  </Style>
  <Style x:Key="Osdrop.Text.Warning" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Body}">
    <Setter Property="Foreground" Value="{StaticResource Osdrop.Brush.Warning}" />
  </Style>
  <Style x:Key="Osdrop.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Osdrop.Text.Caption}">
    <Setter Property="FontFamily" Value="{StaticResource Osdrop.Font.Monospace}" />
  </Style>
  <Style x:Key="Osdrop.Text.Code" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Osdrop.Font.Monospace}" />
    <Setter Property="FontSize" Value="{StaticResource Osdrop.FontSize.PairingCode}" />
    <Setter Property="FontWeight" Value="{StaticResource Osdrop.FontWeight.Emphasis}" />
  </Style>
  <Style x:Key="Osdrop.Button" TargetType="Button">
    <Setter Property="MinWidth" Value="{StaticResource Osdrop.Width.Button}" />
    <Setter Property="Padding" Value="{StaticResource Osdrop.Thickness.ButtonPadding}" />
  </Style>
</ResourceDictionary>
