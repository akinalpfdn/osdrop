<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                    xmlns:res="clr-namespace:Osdrop.Localization;assembly=Osdrop.Localization"
                    xmlns:tray="clr-namespace:Osdrop.App.Tray">
  <tb:TaskbarIcon x:Key="Osdrop.Tray.Icon"
                  ToolTipText="{x:Static res:Strings.TrayToolTip}"
                  d:DataContext="{d:DesignInstance Type=tray:TrayViewModel}"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d">
    <tb:TaskbarIcon.IconSource>
      <tb:GeneratedIconSource Text="{StaticResource Osdrop.Tray.IconGlyph}"
                              Foreground="{StaticResource Osdrop.Brush.TrayIconForeground}"
                              Background="{StaticResource Osdrop.Brush.TrayIconBackground}"
                              FontSize="{StaticResource Osdrop.FontSize.TrayIconGlyph}"
                              FontWeight="{StaticResource Osdrop.FontWeight.TrayIconGlyph}" />
    </tb:TaskbarIcon.IconSource>
    <tb:TaskbarIcon.ContextMenu>
      <ContextMenu>
        <MenuItem Header="{x:Static res:Strings.TrayQuit}" Command="{Binding QuitCommand}" />
      </ContextMenu>
    </tb:TaskbarIcon.ContextMenu>
  </tb:TaskbarIcon>
</ResourceDictionary>
