<!-- A phone's box in its corner (DEVPLAN Phase 21): never takes the focus; the engine places it. -->
<Window x:Class="Osdrop.App.Corners.CornerBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:Osdrop.Localization;assembly=Osdrop.Localization"
        xmlns:corners="clr-namespace:Osdrop.App.Corners"
        xmlns:transfers="clr-namespace:Osdrop.App.Transfers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=corners:CornerBoxViewModel}"
        Title="{Binding Name}"
        Width="{StaticResource Osdrop.Width.CornerBox}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
  <Border Background="{DynamicResource ApplicationBackgroundBrush}"
          BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
          BorderThickness="{StaticResource Osdrop.Thickness.CornerBorder}"
          CornerRadius="{StaticResource Osdrop.Corner.Radius}"
          Padding="{StaticResource Osdrop.Thickness.PanelPadding}">
    <StackPanel>
      <DockPanel>
        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Appearance="Transparent"
                   Command="{Binding CloseCommand}"
                   Visibility="{Binding IsOpen, Converter={StaticResource Osdrop.Converter.Visible}}"
                   ToolTip="{x:Static res:Strings.CornerClose}"
                   AutomationProperties.Name="{x:Static res:Strings.CornerClose}">
          <ui:SymbolIcon Symbol="Dismiss24" FontSize="{StaticResource Osdrop.FontSize.SmallIcon}" />
        </ui:Button>
        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Phone24" FontSize="{StaticResource Osdrop.FontSize.Icon}"
                       Margin="{StaticResource Osdrop.Thickness.IconGap}" VerticalAlignment="Top"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="{Binding Name}" Style="{StaticResource Osdrop.Text.Title}" />
      </DockPanel>
      <TextBlock Margin="{StaticResource Osdrop.Thickness.ItemGap}" Text="{Binding DropHint}"
                 Style="{StaticResource Osdrop.Text.Caption}"
                 Visibility="{Binding ShowsHint, Converter={StaticResource Osdrop.Converter.Visible}}" />
      <StackPanel Visibility="{Binding ShowsRows, Converter={StaticResource Osdrop.Converter.Visible}}">
        <ScrollViewer MaxHeight="{StaticResource Osdrop.Height.CornerList}" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type transfers:TransferRow}">
                <!-- A received file is dragged out from anywhere on its row. -->
                <DockPanel Background="{x:Static Brushes.Transparent}" Tag="{Binding}"
                           PreviewMouseLeftButtonDown="OnRowPressed" PreviewMouseMove="OnRowMoved"
                           PreviewMouseLeftButtonUp="OnRowReleased">
                  <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Appearance="Transparent"
                             Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             CommandParameter="{Binding}"
                             Visibility="{Binding HasFile, Converter={StaticResource Osdrop.Converter.Visible}}"
                             ToolTip="{x:Static res:Strings.CornerShowInFolder}"
                             AutomationProperties.Name="{x:Static res:Strings.CornerShowInFolder}">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="{StaticResource Osdrop.FontSize.SmallIcon}" />
                  </ui:Button>
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Osdrop.Template.TransferRow}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Margin="{StaticResource Osdrop.Thickness.ItemGap}" Text="{x:Static res:Strings.CornerDragOut}"
                   Style="{StaticResource Osdrop.Text.Caption}"
                   Visibility="{Binding HasFiles, Converter={StaticResource Osdrop.Converter.Visible}}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
