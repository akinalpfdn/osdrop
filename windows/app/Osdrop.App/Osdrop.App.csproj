<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Osdrop</AssemblyName>
    <RootNamespace>Osdrop.App</RootNamespace>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <!-- Function pointers and fixed buffers for the engine's C API (Interop/). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osdrop.Localization\Osdrop.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Osdrop.App.Tests" />
  </ItemGroup>

  <!-- The native engine, input process, service and input tool from the CMake build
       (docs/BUILDING.md); override with -p:OsdropNativeBin=<folder> for another preset. They sit
       next to Osdrop.exe, as installed: OsdropInput accepts pipe clients from its own folder only. -->
  <PropertyGroup>
    <OsdropNativeBin Condition="'$(OsdropNativeBin)' == ''">$(MSBuildThisFileDirectory)..\..\build\debug\bin</OsdropNativeBin>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(OsdropNativeBin)\OsdropEngine.dll" Link="OsdropEngine.dll" Visible="false"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(OsdropNativeBin)\OsdropEngine.dll')" />
    <None Include="$(OsdropNativeBin)\OsdropInput.exe" Link="OsdropInput.exe" Visible="false"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(OsdropNativeBin)\OsdropInput.exe')" />
    <None Include="$(OsdropNativeBin)\OsdropService.exe" Link="OsdropService.exe" Visible="false"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(OsdropNativeBin)\OsdropService.exe')" />
    <None Include="$(OsdropNativeBin)\OsdropInputTool.exe" Link="OsdropInputTool.exe" Visible="false"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(OsdropNativeBin)\OsdropInputTool.exe')" />
  </ItemGroup>

</Project>
