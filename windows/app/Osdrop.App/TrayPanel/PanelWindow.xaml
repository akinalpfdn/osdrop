<ui:FluentWindow x:Class="Osdrop.App.TrayPanel.PanelWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:Osdrop.Localization;assembly=Osdrop.Localization"
                 xmlns:panel="clr-namespace:Osdrop.App.TrayPanel"
                 xmlns:group="clr-namespace:Osdrop.App.Group"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=panel:PanelViewModel}"
                 Title="{x:Static res:Strings.AppName}"
                 Width="{StaticResource Osdrop.Width.Panel}"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 WindowStyle="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
  <ui:FluentWindow.Resources>
    <!-- A Mac or a PC, as the member and nearby rows show it. -->
    <Style x:Key="Osdrop.Icon.Platform" TargetType="ui:SymbolIcon">
      <Setter Property="Symbol" Value="Laptop24" />
      <Setter Property="FontSize" Value="{StaticResource Osdrop.FontSize.Icon}" />
      <Setter Property="Margin" Value="{StaticResource Osdrop.Thickness.IconGap}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsWindows}" Value="True">
          <Setter Property="Symbol" Value="Desktop24" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </ui:FluentWindow.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource Osdrop.Thickness.PanelPadding}">
      <!-- Header: name and version; settings and quit as icons (as on the Mac). -->
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <ui:Button Appearance="Transparent" Command="{Binding OpenSettingsCommand}"
                     ToolTip="{x:Static res:Strings.PanelSettings}"
                     AutomationProperties.Name="{x:Static res:Strings.PanelSettings}">
            <ui:SymbolIcon Symbol="Settings24" FontSize="{StaticResource Osdrop.FontSize.Icon}" />
          </ui:Button>
          <ui:Button Appearance="Transparent" Command="{Binding QuitCommand}"
                     ToolTip="{x:Static res:Strings.TrayQuit}"
                     AutomationProperties.Name="{x:Static res:Strings.TrayQuit}">
            <ui:SymbolIcon Symbol="Power24" FontSize="{StaticResource Osdrop.FontSize.Icon}" />
          </ui:Button>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.AppName}" Style="{StaticResource Osdrop.Text.Title}" />
          <TextBlock Text="{Binding VersionText}" Style="{StaticResource Osdrop.Text.Caption}" />
        </StackPanel>
      </DockPanel>

      <!-- Problems first: what the user must act on. -->
      <ui:InfoBar Margin="{StaticResource Osdrop.Thickness.SectionGap}" Severity="Error" IsClosable="False"
                  Message="{Binding StartFailure}" IsOpen="{Binding HasStartFailure, Mode=OneWay}" />
      <TextBlock Margin="{StaticResource Osdrop.Thickness.SectionGap}" Text="{x:Static res:Strings.EngineStarting}"
                 Style="{StaticResource Osdrop.Text.Caption}">
        <TextBlock.Visibility>
          <MultiBinding Converter="{StaticResource Osdrop.Converter.AllFalse}">
            <Binding Path="IsRunning" />
            <Binding Path="HasStartFailure" />
          </MultiBinding>
        </TextBlock.Visibility>
      </TextBlock>
      <StackPanel DataContext="{Binding Control}"
                  Visibility="{Binding HasServiceProblem, Converter={StaticResource Osdrop.Converter.Visible}, FallbackValue=Collapsed}">
        <ui:InfoBar Margin="{StaticResource Osdrop.Thickness.SectionGap}" Severity="Warning" IsClosable="False"
                    Title="{x:Static res:Strings.ServiceTitle}" Message="{Binding ServiceProblem}" IsOpen="True" />
        <ui:Button Margin="{StaticResource Osdrop.Thickness.ItemGap}" Content="{x:Static res:Strings.ServiceRepair}"
                   Command="{Binding RepairCommand}" />
      </StackPanel>
      <StackPanel Visibility="{Binding Updates.IsUpdateAvailable, Converter={StaticResource Osdrop.Converter.Visible}}">
        <ui:InfoBar Margin="{StaticResource Osdrop.Thickness.SectionGap}" Severity="Informational" IsClosable="False"
                    Message="{Binding Updates.AvailableVersionMessage}" IsOpen="True" />
        <ui:Button Margin="{StaticResource Osdrop.Thickness.ItemGap}" Content="{x:Static res:Strings.UpdatesDownload}"
                   Command="{Binding Updates.OpenDownloadCommand}" />
      </StackPanel>

      <!-- Where the input is, and the quick toggles. -->
      <StackPanel DataContext="{Binding Control}"
                  Visibility="{Binding Converter={StaticResource Osdrop.Converter.NotNull}}">
        <TextBlock Margin="{StaticResource Osdrop.Thickness.SectionGap}" Text="{Binding InputStatus}"
                   Style="{StaticResource Osdrop.Text.Caption}"
                   Visibility="{Binding InputStatus, Converter={StaticResource Osdrop.Converter.NotNull}}" />
        <ui:ToggleSwitch Margin="{StaticResource Osdrop.Thickness.ItemGap}" IsChecked="{Binding IsLocked}"
                         AutomationProperties.Name="{Binding LockTitle}">
          <TextBlock Text="{Binding LockTitle}" Style="{StaticResource Osdrop.Text.Body}" />
        </ui:ToggleSwitch>
      </StackPanel>
      <ui:ToggleSwitch Margin="{StaticResource Osdrop.Thickness.ItemGap}" IsChecked="{Binding Settings.SharesClipboard}"
                       Visibility="{Binding IsRunning, Converter={StaticResource Osdrop.Converter.Visible}}"
                       AutomationProperties.Name="{x:Static res:Strings.PanelShareClipboard}">
        <TextBlock Text="{x:Static res:Strings.PanelShareClipboard}" Style="{StaticResource Osdrop.Text.Body}" />
      </ui:ToggleSwitch>

      <!-- Dragged files on their way, in both directions. -->
      <StackPanel DataContext="{Binding Transfers}"
                  Visibility="{Binding HasRows, Converter={StaticResource Osdrop.Converter.Visible}, FallbackValue=Collapsed}">
        <Border Style="{StaticResource Osdrop.Divider}" />
        <TextBlock Margin="{StaticResource Osdrop.Thickness.SectionGap}" Text="{x:Static res:Strings.TransfersTitle}"
                   Style="{StaticResource Osdrop.Text.Section}" />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="{StaticResource Osdrop.Thickness.ItemGap}">
                <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Appearance="Transparent"
                           Command="{Binding CancelCommand}"
                           Visibility="{Binding IsRunning, Converter={StaticResource Osdrop.Converter.Visible}}"
                           ToolTip="{x:Static res:Strings.TransfersCancel}"
                           AutomationProperties.Name="{x:Static res:Strings.TransfersCancel}">
                  <ui:SymbolIcon Symbol="DismissCircle24" FontSize="{StaticResource Osdrop.FontSize.SmallIcon}" />
                </ui:Button>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Osdrop.Text.Body}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Direction}" Style="{StaticResource Osdrop.Text.Caption}" TextWrapping="Wrap" />
                  <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource Osdrop.Converter.Visible}}">
                    <ProgressBar Margin="{StaticResource Osdrop.Thickness.ItemGap}" Value="{Binding Percent, Mode=OneWay}"
                                 Maximum="100" Height="{StaticResource Osdrop.Height.ProgressBar}"
                                 AutomationProperties.Name="{x:Static res:Strings.TransfersProgress}" />
                    <TextBlock Text="{Binding Progress}" Style="{StaticResource Osdrop.Text.Caption}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Status}" Style="{StaticResource Osdrop.Text.Caption}"
                             Visibility="{Binding IsRunning, Converter={StaticResource Osdrop.Converter.Hidden}}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel DataContext="{Binding Group}" Visibility="{Binding Converter={StaticResource Osdrop.Converter.NotNull}}">
        <!-- Copied files on their way from another computer. -->
        <StackPanel DataContext="{Binding ClipboardFetch}"
                    Visibility="{Binding Converter={StaticResource Osdrop.Converter.NotNull}}">
          <Border Style="{StaticResource Osdrop.Divider}" />
          <TextBlock Margin="{StaticResource Osdrop.Thickness.SectionGap}" Text="{Binding Message}"
                     Style="{StaticResource Osdrop.Text.Body}" />
          <ProgressBar Margin="{StaticResource Osdrop.Thickness.ItemGap}" Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                       Height="{StaticResource Osdrop.Height.ProgressBar}"
                       AutomationProperties.Name="{x:Static res:Strings.ClipboardFetchProgress}" />
          <DockPanel Margin="{StaticResource Osdrop.Thickness.ItemGap}">
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Command="{Binding CancelCommand}"
                       ToolTip="{x:Static res:Strings.ClipboardFetchCancel}"
                       AutomationProperties.Name="{x:Static res:Strings.ClipboardFetchCancel}">
              <ui:SymbolIcon Symbol="DismissCircle24" FontSize="{StaticResource Osdrop.FontSize.SmallIcon}" />
            </ui:Button>
            <TextBlock Text="{Binding Progress}" Style="{StaticResource Osdrop.Text.Caption}" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <Border Style="{StaticResource Osdrop.Divider}" />

        <!-- What happened to this PC. -->
        <StackPanel Visibility="{Binding WasRemoved, Converter={StaticResource Osdrop.Converter.Visible}}">
          <ui:InfoBar Margin="{StaticResource Osdrop.Thickness.SectionGap}" Severity="Warning" IsClosable="False"
                      Message="{x:Static res:Strings.GroupRemoved}" IsOpen="True" />
          <ui:Button Margin="{StaticResource Osdrop.Thickness.ItemGap}" Content="{x:Static res:Strings.GroupDismiss}"
                     Command="{Binding DismissRemovalCommand}" />
        </StackPanel>
        <StackPanel Visibility="{Binding HasClipboardNotice, Converter={StaticResource Osdrop.Converter.Visible}}">
          <ui:InfoBar Margin="{StaticResource Osdrop.Thickness.SectionGap}" Severity="Warning" IsClosable="False"
                      Message="{Binding ClipboardNotice}" IsOpen="True" />
          <ui:Button Margin="{StaticResource Osdrop.Thickness.ItemGap}" Content="{x:Static res:Strings.GroupDismiss}"
                     Command="{Binding DismissClipboardNoticeCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- Who controls this PC, the lock, and why the cursor came back. -->
      <StackPanel DataContext="{Binding Control}" Visibility="{Binding Converter={StaticResource Osdrop.Converter.NotNull}}">
        <DockPanel Margin="{StaticResource Osdrop.Thickness.SectionGap}"
                   Visibility="{Binding ControlledBy, Converter={StaticResource Osdrop.Converter.NotNull}}">
          <ui:SymbolIcon DockPanel.Dock="Left" Symbol="CursorHover24" FontSize="{StaticResource Osdrop.FontSize.SmallIcon}"
                         Margin="{StaticResource Osdrop.Thickness.IconGap}" VerticalAlignment="Top" />
          <TextBlock Text="{Binding ControlledBy}" Style="{StaticResource Osdrop.Text.Caption}" />
        </DockPanel>
        <DockPanel Margin="{StaticResource Osdrop.Thickness.ItemGap}"
                   Visibility="{Binding IsLocked, Converter={StaticResource Osdrop.Converter.Visible}}">
          <ui:SymbolIcon DockPanel.Dock="Left" Symbol="LockClosed24" FontSize="{StaticResource Osdrop.FontSize.SmallIcon}"
                         Margin="{StaticResource Osdrop.Thickness.IconGap}" VerticalAlignment="Top" />
          <TextBlock Text="{Binding LockedText}" Style="{StaticResource Osdrop.Text.Caption}" />
        </DockPanel>
        <StackPanel Visibility="{Binding HasNotice, Converter={StaticResource Osdrop.Converter.Visible}}">
          <ui:InfoBar Margin="{StaticResource Osdrop.Thickness.SectionGap}" Severity="Warning" IsClosable="False"
                      Message="{Binding Notice}" IsOpen="True" />
          <ui:Button Margin="{StaticResource Osdrop.Thickness.ItemGap}" Content="{x:Static res:Strings.GroupDismiss}"
                     Command="{Binding DismissNoticeCommand}" />
        </StackPanel>
        <TextBlock Margin="{StaticResource Osdrop.Thickness.ItemGap}" Text="{Binding HintText}"
                   Style="{StaticResource Osdrop.Text.Caption}"
                   Visibility="{Binding ShowsHint, Converter={StaticResource Osdrop.Converter.Visible}}" />
      </StackPanel>

      <!-- The group and the computers nearby. -->
      <StackPanel DataContext="{Binding Group}" Visibility="{Binding Converter={StaticResource Osdrop.Converter.NotNull}}">
        <TextBlock Text="{x:Static res:Strings.GroupMembers}" Style="{StaticResource Osdrop.Text.Section}" />
        <TextBlock Margin="{StaticResource Osdrop.Thickness.ItemGap}" Text="{x:Static res:Strings.GroupEmpty}"
                   Style="{StaticResource Osdrop.Text.Caption}"
                   Visibility="{Binding Members.Count, Converter={StaticResource Osdrop.Converter.Zero}}" />
        <ItemsControl ItemsSource="{Binding Members}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type group:MemberItem}">
              <DockPanel Margin="{StaticResource Osdrop.Thickness.ItemGap}">
                <Ellipse DockPanel.Dock="Left" Style="{StaticResource Osdrop.StatusDot}" />
                <ui:SymbolIcon DockPanel.Dock="Left" Style="{StaticResource Osdrop.Icon.Platform}" />
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" VerticalAlignment="Top"
                           Visibility="{Binding CanRemove, Converter={StaticResource Osdrop.Converter.Visible}}"
                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           Click="OpenMenu"
                           ToolTip="{x:Static res:Strings.GroupRemove}"
                           AutomationProperties.Name="{x:Static res:Strings.GroupRemove}">
                  <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="{StaticResource Osdrop.FontSize.SmallIcon}" />
                  <ui:Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                      <MenuItem Header="{x:Static res:Strings.GroupRemove}" Command="{Binding RevokeCommand}"
                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      <MenuItem Header="{x:Static res:Strings.GroupBlock}" Command="{Binding BlockCommand}"
                                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                  </ui:Button.ContextMenu>
                </ui:Button>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Osdrop.Text.Body}" />
                  <TextBlock Text="{Binding Status}" Style="{StaticResource Osdrop.Text.Caption}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ui:Button Margin="{StaticResource Osdrop.Thickness.SectionGap}" Content="{x:Static res:Strings.GroupLeave}"
                   Command="{Binding LeaveCommand}"
                   Visibility="{Binding HasOthers, Converter={StaticResource Osdrop.Converter.Visible}}" />

        <TextBlock Text="{x:Static res:Strings.GroupNearby}" Style="{StaticResource Osdrop.Text.Section}" />
        <TextBlock Margin="{StaticResource Osdrop.Thickness.ItemGap}" Text="{x:Static res:Strings.GroupNearbyNone}"
                   Style="{StaticResource Osdrop.Text.Caption}"
                   Visibility="{Binding Nearby.Count, Converter={StaticResource Osdrop.Converter.Zero}}" />
        <ItemsControl ItemsSource="{Binding Nearby}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type group:NearbyItem}">
              <DockPanel Margin="{StaticResource Osdrop.Thickness.ItemGap}">
                <ui:SymbolIcon DockPanel.Dock="Left" Style="{StaticResource Osdrop.Icon.Platform}" />
                <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="{x:Static res:Strings.GroupPair}"
                           IsEnabled="{Binding CanPair}"
                           Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           CommandParameter="{Binding}" />
                <StackPanel>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Osdrop.Text.Body}" />
                  <TextBlock Text="{Binding Note}" Style="{StaticResource Osdrop.Text.Caption}"
                             Visibility="{Binding HasNote, Converter={StaticResource Osdrop.Converter.Visible}}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Visibility="{Binding Source={x:Static panel:PanelViewModel.ShowsMesh}, Converter={StaticResource Osdrop.Converter.Visible}}">
        <ui:Button Margin="{StaticResource Osdrop.Thickness.SectionGap}" Content="{x:Static res:Strings.TrayMesh}"
                   Command="{Binding OpenMeshCommand}" />
        <ui:ToggleSwitch Margin="{StaticResource Osdrop.Thickness.ItemGap}" IsChecked="{Binding IsDragLoopback}"
                         IsEnabled="{Binding IsRunning}"
                         AutomationProperties.Name="{x:Static res:Strings.PanelDragLoopback}">
          <TextBlock Text="{x:Static res:Strings.PanelDragLoopback}" Style="{StaticResource Osdrop.Text.Body}" />
        </ui:ToggleSwitch>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ui:FluentWindow>
