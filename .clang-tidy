---
# Rationale for each disabled check lives next to it; everything else in these groups is an error.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -portability-avoid-pragma-once,
  -clang-analyzer-optin.core.EnumCastOutOfRange
# Byte-level codecs use reinterpret_cast, pointer arithmetic and indexing on spans whose bounds
# are checked explicitly in one reader per codec (and fuzzed); magic numbers are reviewed by hand
# because wire offsets are documented in PROTOCOL.md next to their constants.
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(core|windows)/(include|src|engine|input|service|shared)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  # The public C API (osdrop_*) follows C naming conventions.
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^osdrop_[a-z0-9_]+$'
  - key: readability-identifier-naming.EnumConstantIgnoredRegexp
    value: '^OSDROP_[A-Z0-9_]+$'
  - key: readability-identifier-naming.EnumIgnoredRegexp
    value: '^osdrop_[a-z0-9_]+$'
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: true
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: '^osdrop_[a-z0-9_]+$'
  - key: modernize-use-using.IgnoreExternC
    value: true
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  # Win32 functions return BOOL; `if (!CreateFoo())` is the idiom.
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: true
  - key: cppcoreguidelines-macro-usage.AllowedRegexp
    value: '^OSDROP_[A-Z0-9_]+$'
...
