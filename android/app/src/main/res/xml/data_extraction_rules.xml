<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a backup or a device transfer: the identity and group are sealed
     with an Android Keystore key that stays on this phone, so a copy elsewhere could not be read. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
