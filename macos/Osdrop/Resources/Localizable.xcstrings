            "state" : "translated",
            "value" : "Yanındaki bilgisayara geçmek için imleci bir kenara doğru itin. ⌃⌥⌘⎋ geri getirir."
          }
        }
      }
    },
    "control.locked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
