    "developer.capture.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Capture, then put the cursor where you want to work within 3 seconds. Osdrop then takes over this Mac's mouse and keyboard for the chosen time: the cursor hides and stays put, and what you do reaches no app. With replay on, it afterwards plays back what you did from that point, into whichever app has focus. ⌃⌥⌘⎋ ends the capture at once."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakala'ya bas, sonra 3 saniye içinde imleci çalışacağın yere götür. Osdrop seçilen süre boyunca bu Mac'in faresini ve klavyesini devralır: imleç gizlenir ve yerinde kalır, yaptıkların hiçbir uygulamaya ulaşmaz. Tekrar oynatma açıksa ardından yaptıklarını o noktadan başlayarak, odaktaki uygulamaya tekrar oynatır. ⌃⌥⌘⎋ yakalamayı hemen bitirir."
          }
        }
      }
    },
    "developer.capture.focusAcquired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osdrop had keyboard focus during the capture."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama sırasında klavye odağı Osdrop'taydı."
          }
        }
      }
    },
    "developer.capture.focusRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS did not give Osdrop keyboard focus during the capture."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS yakalama sırasında klavye odağını Osdrop'a vermedi."
          }
        }
      }
    },
