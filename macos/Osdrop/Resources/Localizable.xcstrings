    "developer.drag.dropped %lld %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropped. Written: %1$lld, failed: %2$lld (large items keep writing; Finder shows their progress)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bırakıldı. Yazılan: %1$lld, başarısız: %2$lld (büyük öğeler yazılmaya devam eder; ilerlemesini Finder gösterir)."
          }
        }
      }
    },
    "developer.drag.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arm, then drag files or folders from Finder or Photos to the right edge of the main display: a green strip appears there during the drag. Release on it. Then press Drop with Osdrop and put the cursor where the items should land within 3 seconds; Osdrop drags them there from the left edge while it holds this Mac's input."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazırla'ya bas, sonra Finder'dan ya da Fotoğraflar'dan dosya veya klasörleri ana ekranın sağ kenarına sürükle: sürükleme sırasında orada yeşil bir şerit çıkar. Şeridin üstünde bırak. Ardından Osdrop ile Bırak'a bas ve 3 saniye içinde imleci öğelerin gideceği yere götür; Osdrop bu Mac'in girdisini tutarken onları sol kenardan oraya sürükler."
          }
        }
      }
    },
    "developer.drag.item %@ %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
