      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Drop with Osdrop, then put the cursor on a Finder window, the desktop or an app."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osdrop ile Bırak'a bas, sonra imleci bir Finder penceresine, masaüstüne ya da bir uygulamaya götür."
